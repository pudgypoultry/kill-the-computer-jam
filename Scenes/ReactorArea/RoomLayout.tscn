talk_message = Array[String](["ST. ???", "And I am in a coffin"])

[node name="SkeletonCoffin3" parent="Skeletons/OldVersions" unique_id=1126042396 instance=ExtResource("19_4tam1")]
transform = Transform3D(-4.371139e-08, 0, -1, 0, 1, 0, 1, 0, -4.371139e-08, 49, 1.3826284, -136.41574)
talk_message = Array[String](["ST. CORNELIUS: ", "\"G-God punishes the W-wicked, does it not? S-so if I r-r-remain virtuous, even God's light c-cannot burn m-me, s-s-surely?\" "])

[node name="SkeletonPodium" parent="Skeletons/OldVersions" unique_id=2113007376 instance=ExtResource("21_bs17m")]
transform = Transform3D(-1, 0, 8.742278e-08, 0, 1, 0, -8.742278e-08, 0, -1, 25, 1.776, -115.5)
talk_message = Array[String](["ST. TITUS", "\"The Map is ancient, the Place changeable. ", "\"Do not trust one screen alone.\""])

[node name="SkeletonPodium3" parent="Skeletons/OldVersions" unique_id=702942377 instance=ExtResource("21_bs17m")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 16, 1.776, -145.5)
talk_message = Array[String](["ST. CHRYSANTHEMUM:", "\"In my dreams, I see God. ", "But not as the Fathers and Mothers spoke of it, no. I see God blooming, on the horizon, a vast and beautiful cloud. ", "So sickly sweet I taste it in my teeth. ", "God blessed this world by blooming.\""])

[node name="SkeletonPodium2" parent="Skeletons/OldVersions" unique_id=1481574537 instance=ExtResource("21_bs17m")]
transform = Transform3D(1, 0, -1.7484555e-07, 0, 1, 0, 1.7484555e-07, 0, 1, 40, 1.776, -121.5)
talk_message = Array[String](["ST. JANUARIUS", "\"There will come an ever cold Winter, when God's dominion touches all. ", "Do not fear it, for its Glory will reign Eternal.\""])

[node name="SkeletonCoffin9" parent="Skeletons/OldVersions" unique_id=1988752239 instance=ExtResource("19_4tam1")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 28.62, 2, -124.75)
talk_message = Array[String](["ST. JEANNE", "\"What's up? Oh, hey, so funny story. They totally got the wrong corpse. I don't know what the hell I'm doing here, but I promise you, Saint I ain't. They shoved this Apparatus on me and told me that, in the last moments that my consciousness still flickered, on its way to Ascend toward the Labyrinth, this doohickey would record what I was thinking about it, preserve it for the 'Glory of God' for 'All Eternity.' Ask me, that's all a load of bullwash and hogshit. I think right about now, I'm fading out, and that's about all there is to it. Oh, sure, some sap will get the shot to pilot my empty shell into the \"Temple\" to \"Glimpse God,\" but honey, the lights are all out. No one's home. You're all alone. Yeah, you, reading this right now, I'm talking to you. Whoever you think you're talking to, that's just the dying embers of a mind too mired in its own dogma to see one single thing straight, not even as they're shuffling off this old mortal coil. But me? I think I'm getting to the heart of, ain't I, even as I diminish. I'm freaking you out, ain't I, just a little bit? Good. Well. Here I go, I'm just about out of here. Good luck finding your God. I hope it's worth it. Bye forever. [..................] Oh.\" "])

