[node name="Skeletons" type="Node3D" parent="." unique_id=1562671743]

[node name="SkeletonA" parent="Skeletons" unique_id=892404425 instance=ExtResource("19_4tam1")]
transform = Transform3D(0.061934084, 0, 0.9980803, 0, 1, 0, -0.9980803, 0, 0.061934084, -4.5, 0, -7.5)
talk_message = Array[String](["\"The answer you seek is written on my face for all to see. ", "Look closely and ye shall find.\""])

[node name="SkeletonB" parent="Skeletons" unique_id=1468821949 instance=ExtResource("19_4tam1")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.5, 0, -10.5)
talk_message = Array[String](["\"As Saint Ex taught you, it is fission and fusion together that govern all things. ", "Fusion is the righteous path; sometimes two may proceed where one cannot.", "For you, the blessing of Fusion.\""])

[node name="SkeletonC" parent="Skeletons" unique_id=657345094 instance=ExtResource("19_4tam1")]
transform = Transform3D(-4.4703484e-08, 0, -1, 0, 1, 0, 1, 0, -4.4703484e-08, 7.5, 0, -7.5)
talk_message = Array[String](["\"Fission is the sinistral path—the division of the atom, which brought woe until the world, is not to be trifled with.", "Yet, only by fission and fusion together can one tread the pathway to the Holiest of Holies.", "For you, the curse of Fission.\""])

[node name="SkeletonD" parent="Skeletons" unique_id=425853638 instance=ExtResource("19_4tam1")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 16.5, 0, -13.5)
talk_message = Array[String](["\"The atom is the smallest of seeds, yet its might can render a mountain down to cinders.", "Halo grants the power to see both the very large and the very small, the world of the atom and the world beyond.", "Receive now the boon of Halo.\""])

[node name="SkeletonE" parent="Skeletons" unique_id=1571419232 instance=ExtResource("19_4tam1")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 22.5, 0, -13.5)
talk_message = Array[String](["\"Halo is also a shockwave—the very breath of the God in the Atom that makes a mockery of the fragile works of man.", "The tunnels beyond here have collapsed, but this too is a sign. Know that God is everywhere.\""])

[node name="SkeletonF" parent="Skeletons" unique_id=1197911493 instance=ExtResource("21_bs17m")]
transform = Transform3D(0.20983219, 0, -0.9777374, 0, 1, 0, 0.9777374, 0, 0.20983219, 31, 0, -7)
talk_message = Array[String](["\"Oh initiate, permit me to interpret the true meaning of the Commandments by which you control your Blessed Saint:", "It is through the 'Cruciform' that we speak with and understand the world.\" "])

[node name="SkeletonG" parent="Skeletons" unique_id=602876167 instance=ExtResource("21_bs17m")]
transform = Transform3D(0.20983219, 0, -0.9777374, 0, 1, 0, 0.9777374, 0, 0.20983219, 31, 0, -2)
talk_message = Array[String](["\"Oh initiate, permit me to interpret the true meaning of the Commandments by which you control your Blessed Saint:", "It seems you've been taught these ones already, but to refresh:", "The right hand path is 'Fusion.' The left hand path is 'Fission.' ", "'Halo' lets us see the truth, both large and small.\""])

[node name="SkeletonH" parent="Skeletons" unique_id=379935278 instance=ExtResource("19_4tam1")]
transform = Transform3D(-0.9302268, 0, 0.36698514, 0, 1, 0, -0.36698514, 0, -0.9302268, 25, 0, -1)
talk_message = Array[String](["\"Oh initiate, permit me to interpret the true meaning of the Commandments by which you control your Blessed Saint:", "'Fallout' is the path, though whether it carries us forward or backward, we cannot yet say.\""])

[node name="SkeletonI" parent="Skeletons" unique_id=1102765580 instance=ExtResource("21_bs17m")]
transform = Transform3D(-0.99162894, 0, -0.12912127, 0, 1, 0, 0.12912127, 0, -0.99162894, 19.564873, 0, -2.4578445)
talk_message = Array[String](["\"The Cruciform's first task was Fission—", "Eternal division between the time before, and the time to come.\" "])

[node name="SkeletonJ" parent="Skeletons" unique_id=410653855 instance=ExtResource("21_bs17m")]
transform = Transform3D(-0.091266006, 0, -0.99582666, 0, 1, 0, 0.99582666, 0, -0.091266006, 15.652, 0, 1.388)
talk_message = Array[String](["\"I have read the ancient texts. I have suffered through scripture. I have annotated the Apocrypha. ", "My conclusion? ", "I wonder: instead of all this, our vast task of eternal preservation.", "Mightn't we simply have chosen not to create it at all? God?\" "])

[node name="SkeletonK" parent="Skeletons" unique_id=342856809 instance=ExtResource("21_bs17m")]
transform = Transform3D(0.14695807, 0, 0.9891427, 0, 1, 0, -0.9891427, 0, 0.14695807, -17.678617, 0, -4.415737)
talk_message = Array[String](["\"Someday you too will receive the gift of the apparatus.", "Reunited with your erstwhile mentor here in supplication before the light of God that melts both flesh and organs.", "You too will be Commanded into the Core.\""])

[node name="SkeletonL" parent="Skeletons" unique_id=988356585 instance=ExtResource("21_bs17m")]
transform = Transform3D(-4.371139e-08, 0, 1, 0, 1, 0, -1, 0, -4.371139e-08, -16.5, 0, -10.5)
talk_message = Array[String](["\"Before you enter, and gaze upon Glory, consider: ", "If instead the world as written no longer suits you, ", "If all must burn and begin anew, ", "take the leftward Path toward Fallout.\""])

[node name="SkeletonM" parent="Skeletons" unique_id=502640425 instance=ExtResource("21_bs17m")]
transform = Transform3D(-4.371139e-08, 0, -1, 0, 1, 0, 1, 0, -4.371139e-08, -10.5, 0, -10.5)
talk_message = Array[String](["\"Before you enter, and gaze upon Glory, consider: ", "Should you wish to preserve this present cycle, ", "To join in the company of Saints, our divine Halo.", "Take the rightward Path.\""])

[node name="OldVersions" type="Node3D" parent="Skeletons" unique_id=462912281]
visible = false

[node name="SkeletonPodium10" parent="Skeletons/OldVersions" unique_id=249106398 instance=ExtResource("21_bs17m")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 26, 1.5, -148)
talk_message = Array[String](["ST. ", "And I am on a podium"])

[node name="SkeletonCoffin14" parent="Skeletons/OldVersions" unique_id=343718707 instance=ExtResource("19_4tam1")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 47.98, 2, -145.92)
talk_message = Array[String](["ST. STEPHEN", "Oh mine student. I have faith that together, we will succeed in reaching the Core and completing the Holiest of Holy Rituals, within the very presence of God.", "Regardless of your horrible sense of direction.\""])

[node name="SkeletonPodium9" parent="Skeletons/OldVersions" unique_id=935706400 instance=ExtResource("21_bs17m")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 44, 2, -142.8)
talk_message = Array[String](["ST. GILES", "????"])

[node name="SkeletonPodium8" parent="Skeletons/OldVersions" unique_id=762209941 instance=ExtResource("21_bs17m")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 44, 2, -148)
talk_message = Array[String](["ST. BUCOLUS:", "\"How fares the world of men without these walls? Do they still wither? Does the sickness spread? Has our task succeeded?\""])

[node name="SkeletonCoffin13" parent="Skeletons/OldVersions" unique_id=78579862 instance=ExtResource("19_4tam1")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 32, 1.5, -148)
talk_message = Array[String](["ST. ZELIE", "And I am in a coffin"])

