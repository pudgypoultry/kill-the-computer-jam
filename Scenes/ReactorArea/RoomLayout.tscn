transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 23, 2, -144)
talk_message = Array[String](["ST. HORATIO:", "Riddle to exit Turbine room"])

[node name="SkeletonCoffin8" parent="Skeletons/OldVersions" unique_id=1887867889 instance=ExtResource("19_4tam1")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 22, 2, -125.01)
talk_message = Array[String](["ST. GUINEFORT:", "Arf, arf, arf!!!"])

[node name="SkeletonCoffin7" parent="Skeletons/OldVersions" unique_id=1695974037 instance=ExtResource("19_4tam1")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 28.7, 2, -130)
talk_message = Array[String](["ST. PA0L:", "\"I asked to be fitted with the Apparatus before my time, to glimpse in life the light of God's wisdom and terror. They denied me. ", "So I sought out the tools myself, becoming more machine than man. ", "Even then I could not touch the truth lurking behind divine mystery.\" "])

[node name="SkeletonCoffin" parent="Skeletons/OldVersions" unique_id=157597289 instance=ExtResource("19_4tam1")]
transform = Transform3D(-4.371139e-08, 0, 1, 0, 1, 0, -1, 0, -4.371139e-08, 22, 2, -130)
talk_message = Array[String](["ST. CELSIUS:", "\"DO NOT TOUCH THE BLESSED THERMOSTAT. ", "DESTABILIZING GOD'S TEMPERATURE WILL ONLY BRING DESTRUCTION.  ", "Thank you.\""])

[node name="SkeletonCoffin2" parent="Skeletons/OldVersions" unique_id=208339710 instance=ExtResource("19_4tam1")]
